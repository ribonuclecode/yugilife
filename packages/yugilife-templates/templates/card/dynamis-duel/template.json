  "presentationRules": [
    {
      "id": "monster-common",
      "when": {
        "path": "kind",
        "equals": "monster"
      },
      "layerVisibility": {
        "levelPlate": true,
        "levelLabel": true,
        "level": true,
        "attribute": true,
        "attributeGlyph": true,
        "atkBadge": true,
        "atkLabel": true,
        "atk": true,
        "statsSeparator": true,
        "def": true,
        "defBadge": true,
        "defLabel": true
      }
    },
    {
      "id": "monster-frame-normal",
      "when": {
        "path": "monster.frame",
        "equals": "normal"
      },
      "presets": {
        "frame": "dynamis-normal-frame"
      }
    },
    {
      "id": "monster-frame-effect",
      "when": {
        "path": "monster.frame",
        "equals": "effect"
      },
      "presets": {
        "frame": "dynamis-effect-frame"
      }
    },
    {
      "id": "monster-frame-ritual",
      "when": {
        "path": "monster.frame",
        "equals": "ritual"
      },
      "presets": {
        "frame": "dynamis-ritual-frame"
      }
    },
    {
      "id": "monster-frame-fusion",
      "when": {
        "path": "monster.frame",
        "equals": "fusion"
      },
      "presets": {
        "frame": "dynamis-fusion-frame"
      }
    },
    {
      "id": "monster-frame-ultimatch",
      "when": {
        "path": "monster.frame",
        "equals": "ultimatch"
      },
      "presets": {
        "frame": "dynamis-ultimatch-frame"
      }
    },
    {
      "id": "monster-frame-transformation",
      "when": {
        "path": "monster.frame",
        "equals": "transformation"
      },
      "presets": {
        "frame": "dynamis-transformation-frame"
      }
    },
    {
      "id": "monster-frame-god",
      "when": {
        "path": "monster.frame",
        "equals": "god"
      },
      "presets": {
        "frame": "dynamis-god-frame"
      }
    },
    {
      "id": "monster-attribute-dark",
      "when": {
        "path": "monster.attribute",
        "equals": "DARK"
      },
      "layerVisibility": {
        "attributePlateDark": true
      }
    },
    {
      "id": "monster-attribute-light",
      "when": {
        "path": "monster.attribute",
        "equals": "LIGHT"
      },
      "layerVisibility": {
        "attributePlateLight": true
      }
    },
    {
      "id": "monster-attribute-earth",
      "when": {
        "path": "monster.attribute",
        "equals": "EARTH"
      },
      "layerVisibility": {
        "attributePlateEarth": true
      }
    },
    {
      "id": "monster-attribute-water",
      "when": {
        "path": "monster.attribute",
        "equals": "WATER"
      },
      "layerVisibility": {
        "attributePlateWater": true
      }
    },
    {
      "id": "monster-attribute-fire",
      "when": {
        "path": "monster.attribute",
        "equals": "FIRE"
      },
      "layerVisibility": {
        "attributePlateFire": true
      }
    },
    {
      "id": "monster-attribute-wind",
      "when": {
        "path": "monster.attribute",
        "equals": "WIND"
      },
      "layerVisibility": {
        "attributePlateWind": true
      }
    },
    {
      "id": "monster-attribute-divine",
      "when": {
        "path": "monster.attribute",
        "equals": "DIVINE"
      },
      "layerVisibility": {
        "attributePlateDivine": true
      }
    },
    {
      "id": "spell-card",
      "when": {
        "path": "kind",
        "equals": "spell"
      },
      "presets": {
        "frame": "dynamis-spell-frame"
      },
      "layerVisibility": {
        "attributePlateSpell": true,
        "attribute": true,
        "attributeGlyph": true,
        "spellTrapIconPlate": true
      },
      "textValues": {
        "attribute": "SPELL",
        "attributeGlyph": "魔"
      }
    },
    {
      "id": "trap-card",
      "when": {
        "path": "kind",
        "equals": "trap"
      },
      "presets": {
        "frame": "dynamis-trap-frame"
      },
      "layerVisibility": {
        "attributePlateTrap": true,
        "attribute": true,
        "attributeGlyph": true,
        "spellTrapIconPlate": true
      },
      "textValues": {
        "attribute": "TRAP",
        "attributeGlyph": "罠"
      }
    },
    {
      "id": "spell-trap-icon-continuous",
      "when": {
        "path": "spellTrap.type",
        "equals": "continuous"
      },
      "layerVisibility": {
        "spellTrapIconContinuous": true
      }
    },
    {
      "id": "spell-trap-icon-counter",
      "when": {
        "path": "spellTrap.type",
        "equals": "counter"
      },
      "layerVisibility": {
        "spellTrapIconCounter": true
      }
    },
    {
      "id": "spell-trap-icon-equip",
      "when": {
        "path": "spellTrap.type",
        "equals": "equip"
      },
      "layerVisibility": {
        "spellTrapIconEquip": true
      }
    },
    {
      "id": "spell-trap-icon-field",
      "when": {
        "path": "spellTrap.type",
        "equals": "field"
      },
      "layerVisibility": {
        "spellTrapIconField": true
      }
    },
    {
      "id": "spell-trap-icon-quick-play",
      "when": {
        "path": "spellTrap.type",
        "equals": "quick-play"
      },
      "layerVisibility": {
        "spellTrapIconQuickPlay": true
      }
    },
    {
      "id": "spell-trap-icon-ritual",
      "when": {
        "path": "spellTrap.type",
        "equals": "ritual"
      },
      "layerVisibility": {
        "spellTrapIconRitual": true
      }
    },
    {
      "id": "aether-icon",
      "when": {
        "path": "aether",
        "equals": true
      },
      "layerVisibility": {
        "aetherIcon": true
      }
    },
    {
      "id": "signature-move-star",
      "when": {
        "path": "signatureMove",
        "equals": true
      },
      "layerVisibility": {
        "signatureStar": true
      }
    }
  ]
}
