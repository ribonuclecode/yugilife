{
  "schemaVersion": 1,
  "dimensions": {
    "width": 813,
    "height": 1185
  },
  "fonts": {
    "DFP-ReiSho-W6": "font.dfp-reisho-w6-jajwa",
    "StoneSerifStd-Bold": "font.itc-stone-serif-std-bold",
    "StoneSerifITCTTBold-ArtificialSC": "font.stone-serif-itc-tt-sc-bold",
    "MatrixRegularSmallCaps": "font.matrix-regular-small-caps",
    "MatrixBoldSmallCaps": "font.matrix-bold-small-caps",
    "MatrixBook": "font.matrix-book",
    "ITCStoneSerifMedium": "font.itc-stone-serif-medium"
  },
  "textDefaults": {
    "autoScaleXQuantifier": 0.01,
    "maxAutoCompressionX": 0.2
  },
  "fitProfileSets": {
    "description": [
      {
        "id": "large",
        "label": "Large",
        "fontSize": 30,
        "lineHeight": 30,
        "maxLines": 5
      },
      {
        "id": "medium",
        "label": "Medium",
        "fontSize": 24.4,
        "lineHeight": 25,
        "maxLines": 6
      },
      {
        "id": "small",
        "label": "Small",
        "fontSize": 21,
        "lineHeight": 22,
        "maxLines": 7
      },
      {
        "id": "extra-small",
        "label": "Extra Small",
        "fontSize": 17,
        "lineHeight": 16.67,
        "maxLines": 9
      }
    ],
    "type-line": [
      {
        "id": "type-big",
        "label": "Type big",
        "fontSize": 31
      },
      {
        "id": "type-small",
        "label": "Type small",
        "fontSize": 24
      }
    ]
  },
  "cardFields": [
    {
      "name": "name",
      "kind": "text",
      "label": "Name",
      "maxLength": 80,
      "defaultValue": "Magician Of Chaos"
    },
    {
      "name": "cardVariant",
      "kind": "text",
      "label": "Card type",
      "required": true,
      "options": [
        "normal",
        "effect",
        "ritual",
        "fusion",
        "ultimatch",
        "transformation",
        "god",
        "spell",
        "trap"
      ],
      "defaultValue": "effect"
    },
    {
      "name": "attribute",
      "kind": "text",
      "label": "Attribute",
      "automaticWhen": {
        "path": "kind",
        "equals": "monster"
      },
      "options": ["DARK", "LIGHT", "EARTH", "WATER", "FIRE", "WIND", "DIVINE"],
      "defaultValue": "DARK"
    },
    {
      "name": "spellTrapType",
      "kind": "text",
      "label": "Spell/Trap type",
      "automaticWhen": [
        {
          "path": "kind",
          "equals": "spell"
        },
        {
          "path": "kind",
          "equals": "trap"
        }
      ],
      "options": ["normal", "continuous", "counter", "equip", "field", "quick-play", "ritual"],
      "defaultValue": "normal"
    },
    {
      "name": "level",
      "kind": "number",
      "label": "Level",
      "automaticWhen": {
        "path": "kind",
        "equals": "monster"
      },
      "min": 1,
      "max": 12,
      "defaultValue": 7
    },
    {
      "name": "types",
      "kind": "text-list",
      "label": "Type line",
      "maxItems": 4,
      "defaultValue": ["Spellcaster", "Ritual", "Effect"]
    },
    {
      "name": "description",
      "kind": "multiline",
      "label": "Effect text",
      "automaticFitLayer": "description",
      "maxItems": 10,
      "defaultValue": "<b>1.</b> This card's name becomes \"Dark Magician\" while on the field or in the GY.\n<b>2.</b> (Quick, 1/Turn) When a Spell/Trap is activated, you can: [Target 1 card on the field] Destroy it."
    },
    {
      "name": "attack",
      "kind": "text",
      "label": "ATK",
      "automaticWhen": {
        "path": "kind",
        "equals": "monster"
      },
      "defaultValue": "2500"
    },
    {
      "name": "defense",
      "kind": "text",
      "label": "DEF",
      "automaticWhen": {
        "path": "kind",
        "equals": "monster"
      },
      "defaultValue": "2100"
    },
    {
      "name": "era",
      "kind": "number",
      "label": "Era",
      "min": 1,
      "max": 99,
      "defaultValue": 1
    },
    {
      "name": "effectGroup",
      "kind": "text",
      "label": "Effect group",
      "maxLength": 24,
      "defaultValue": "X-DESTROY CARDS"
    },
    {
      "name": "aether",
      "kind": "boolean",
      "label": "Aether card",
      "defaultValue": false
    },
    {
      "name": "signatureMove",
      "kind": "boolean",
      "label": "Has Signature Move",
      "defaultValue": false
    },
    {
      "name": "setId",
      "kind": "text",
      "label": "Set ID",
      "maxLength": 16,
      "defaultValue": "DM01-001"
    },
    {
      "name": "artwork",
      "kind": "image",
      "label": "Artwork"
    },
    {
      "name": "artworkOverlay",
      "kind": "image",
      "label": "Artwork alpha mask",
      "advancedOnly": true
    }
  ],
  "semanticBindings": {
    "bindings": [
      {
        "path": "kind",
        "source": {
          "field": "cardVariant"
        },
        "transform": {
          "kind": "lookup",
          "values": {
            "normal": "monster",
            "effect": "monster",
            "ritual": "monster",
            "fusion": "monster",
            "ultimatch": "monster",
            "transformation": "monster",
            "god": "monster",
            "spell": "spell",
            "trap": "trap"
          }
        }
      },
      {
        "path": "monster.frame",
        "source": {
          "field": "cardVariant"
        },
        "transform": {
          "kind": "lookup",
          "values": {
            "normal": "normal",
            "effect": "effect",
            "ritual": "ritual",
            "fusion": "fusion",
            "ultimatch": "ultimatch",
            "transformation": "transformation",
            "god": "god"
          }
        },
        "when": {
          "path": "kind",
          "equals": "monster"
        }
      },
      {
        "path": "monster.attribute",
        "source": {
          "field": "attribute"
        },
        "when": {
          "path": "kind",
          "equals": "monster"
        }
      },
      {
        "path": "monster.attributeGlyph",
        "source": {
          "field": "attribute"
        },
        "transform": {
          "kind": "lookup",
          "values": {
            "DARK": "闇",
            "LIGHT": "光",
            "EARTH": "地",
            "WATER": "水",
            "FIRE": "炎",
            "WIND": "風",
            "DIVINE": "神"
          }
        },
        "when": {
          "path": "kind",
          "equals": "monster"
        }
      },
      {
        "path": "monster.levelLabel",
        "source": {
          "value": "LEVEL"
        },
        "when": {
          "path": "kind",
          "equals": "monster"
        }
      },
      {
        "path": "monster.atkLabel",
        "source": {
          "value": "ATK"
        },
        "when": {
          "path": "kind",
          "equals": "monster"
        }
      },
      {
        "path": "monster.defLabel",
        "source": {
          "value": "DEF"
        },
        "when": {
          "path": "kind",
          "equals": "monster"
        }
      },
      {
        "path": "spellTrap.type",
        "source": {
          "field": "spellTrapType"
        },
        "when": {
          "path": "kind",
          "in": ["spell", "trap"]
        }
      },
      {
        "path": "aether",
        "source": {
          "field": "aether"
        },
        "fallback": {
          "kind": "value",
          "value": false
        }
      },
      {
        "path": "aether.glyph",
        "source": {
          "value": "Æ"
        },
        "when": {
          "path": "aether",
          "equals": true
        }
      },
      {
        "path": "signatureMove",
        "source": {
          "field": "signatureMove"
        },
        "fallback": {
          "kind": "value",
          "value": false
        }
      }
    ]
  },
